{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["DOM", "ESNext"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    },
    "types": ["vite/client", "node", "naive-ui/volar", "vite-plugin-pwa/client"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.vue", "./**/*.d.ts", "./**/*.json"],
  "exclude": ["node_modules", "dist"]
}
