{
  "name": "frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "一个基于Vue3、Vite7、TypeScript、NaiveUI and UnoCSS的清新优雅前台模版。",
  "author": {
    "name": "Rouarn",
    "email": "woyuxiaji@foxmail.com",
    "url": "https://github.com/Rouarn"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/Rouarn/frontend-template",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "prepare": "husky",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@sa/color": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "clipboard": "^2.0.11",
    "consola": "^3.4.2",
    "dayjs": "^1.11.19",
    "defu": "^6.1.4",
    "localforage": "^1.10.0",
    "md-editor-v3": "^6.2.0",
    "naive-ui": "^2.43.2",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vfonts": "^0.0.3",
    "vue": "^3.5.25",
    "vue-cropper": "^1.1.4",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@iconify/json": "^2.2.412",
    "@iconify/utils": "^3.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.10.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "commitizen": "^4.3.1",
    "consola": "3.4.2",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "~10.5.1",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.3",
    "sass-embedded": "^1.93.3",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "unocss": "^66.5.9",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-plugin-pages": "^0.33.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "website": "http://www.shixian.xyz"
}
